        <button onclick="window.open('https://t.me/Cs-skydoopedia', '_blank')" class="lp-btn lp-btn--ghost lp-btn--sm"><i class="bi bi-chat"></i> Hubungi CS</button>
        <button onclick="location.href='mailto:doopediaid@gmail.com'" class="lp-btn lp-btn--ghost lp-btn--sm"><i class="bi bi-envelope"></i> Email</button>
