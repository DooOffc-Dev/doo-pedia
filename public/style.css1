* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background: #0a0e17;
    color: #fff;
    padding-bottom: 80px;
    overflow-x: hidden;
}

/* ========================================== */
/* LOADING */
/* ========================================== */
#loading {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #0a0e17;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    transition: opacity 0.8s;
}
#loading.hide { opacity: 0; pointer-events: none; }
.loader { text-align: center; }
.loader img { width: 100px; animation: pulse 1.5s ease-in-out infinite; }
.loader-bar { width: 200px; height: 4px; background: #0f1a2e; border-radius: 2px; margin: 20px auto; overflow: hidden; }
.loader-bar::after { content: ''; display: block; width: 40%; height: 100%; background: linear-gradient(90deg, #0066CC, #0088FF); border-radius: 2px; animation: load 1s ease-in-out infinite; }
@keyframes load { 0% { transform: translateX(-100%); } 100% { transform: translateX(350%); } }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }

/* ========================================== */
/* HEADER */
/* ========================================== */
.header {
    background: linear-gradient(135deg, #0a0e17, #0f1a2e);
    padding: 15px 20px 20px;
    border-bottom: 1px solid rgba(0, 102, 204, 0.1);
    position: sticky;
    top: 0;
    z-index: 100;
}
.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}
.header-brand { display: flex; align-items: center; gap: 10px; }
.header-logo { width: 32px; height: 32px; border-radius: 8px; }
.header-brand span { font-size: 18px; font-weight: 800; background: linear-gradient(135deg, #0066CC, #0088FF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.auth-btn { background: rgba(0, 102, 204, 0.15); border: none; color: #0088FF; width: 38px; height: 38px; border-radius: 50%; font-size: 16px; cursor: pointer; transition: all 0.3s; }
.auth-btn:hover { background: rgba(0, 102, 204, 0.3); }
.header-balance {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    padding: 12px 16px;
    border: 1px solid rgba(0, 102, 204, 0.05);
}
.balance-label { color: #445566; font-size: 12px; font-weight: 500; }
.balance-amount { font-size: 20px; font-weight: 700; color: #0088FF; display: flex; align-items: center; gap: 8px; }
.balance-amount i { font-size: 16px; }
.deposit-btn { background: linear-gradient(135deg, #0066CC, #0088FF); border: none; color: #fff; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 4px; }
.deposit-btn:hover { transform: scale(1.05); }
.header-user { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding: 8px 12px; background: rgba(255, 255, 255, 0.02); border-radius: 8px; }
.header-user span { color: #8899bb; font-size: 14px; font-weight: 500; }
.logout-btn { background: none; border: none; color: #ff4444; cursor: pointer; font-size: 14px; }

/* ========================================== */
/* HERO SLIDER */
/* ========================================== */
.hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 100px 20px 50px;
    position: relative;
    overflow: hidden;
}
.hero-bg {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 70%;
    height: 120%;
    background: radial-gradient(ellipse, rgba(0, 102, 204, 0.06), transparent 70%);
    z-index: 0;
}
.hero-slider {
    position: relative;
    width: 100%;
    max-width: 1200px;
    z-index: 1;
    overflow: hidden;
}
.hero-slides { position: relative; width: 100%; }
.hero-slide { display: none; animation: fadeSlide 0.6s ease; }
.hero-slide.active { display: block; }
@keyframes fadeSlide { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.hero-content { display: flex; align-items: center; gap: 50px; padding: 20px 0; }
.hero-text { flex: 1; }
.hero-text h1 { font-size: 48px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; }
.hero-text h1 span { color: #0088FF; background: none; -webkit-text-fill-color: #0088FF; }
.hero-text p { font-size: 18px; color: #8899bb; line-height: 1.8; margin-bottom: 30px; }
.hero-image { flex: 1; display: flex; justify-content: center; }
.hero-image img { max-width: 100%; max-height: 350px; animation: float 6s ease-in-out infinite; border-radius: 16px; }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }

/* Slider Controls */
.slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 102, 204, 0.15);
    border: 1px solid rgba(0, 102, 204, 0.15);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    transition: all 0.3s;
    z-index: 10;
    backdrop-filter: blur(10px);
}
.slider-btn:hover { background: rgba(0, 102, 204, 0.3); border-color: rgba(0, 102, 204, 0.3); }
.slider-btn.prev { left: -20px; }
.slider-btn.next { right: -20px; }
.slider-dots { display: flex; justify-content: center; gap: 10px; margin-top: 25px; }
.dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    cursor: pointer;
    transition: all 0.3s;
    border: none;
}
.dot.active { background: #0088FF; width: 32px; border-radius: 6px; }
.dot:hover { background: rgba(0, 136, 255, 0.5); }

/* Hero Stats */
.hero-stats {
    display: flex;
    gap: 60px;
    margin-top: 40px;
    z-index: 1;
    padding: 30px 50px;
    background: rgba(0, 102, 204, 0.03);
    border-radius: 20px;
    border: 1px solid rgba(0, 102, 204, 0.05);
}
.stat-number { font-size: 36px; font-weight: 800; color: #0088FF; display: block; }
.stat-label { color: #445566; font-size: 14px; }

/* ========================================== */
/* CATEGORY TABS */
/* ========================================== */
.category-tabs {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    background: #0a0e17;
    overflow-x: auto;
    border-bottom: 1px solid rgba(0, 102, 204, 0.05);
    position: sticky;
    top: 110px;
    z-index: 99;
}
.category-tabs::-webkit-scrollbar { display: none; }
.category-btn {
    background: rgba(255, 255, 255, 0.03);
    border: none;
    color: #445566;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
}
.category-btn.active { background: rgba(0, 102, 204, 0.12); color: #0088FF; border: 1px solid rgba(0, 102, 204, 0.15); }
.category-btn:hover { background: rgba(0, 102, 204, 0.06); }

/* ========================================== */
/* MAIN CONTENT */
/* ========================================== */
.main-content { padding: 16px; max-width: 600px; margin: 0 auto; }
.services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }

/* ========================================== */
/* SERVICE CARD */
/* ========================================== */
.service-card {
    background: #0f1a2e;
    border: 1px solid rgba(0, 102, 204, 0.06);
    border-radius: 12px;
    padding: 16px;
    text-align: center;
    transition: all 0.3s;
    cursor: pointer;
}
.service-card:hover { transform: translateY(-2px); border-color: rgba(0, 102, 204, 0.15); box-shadow: 0 4px 20px rgba(0, 102, 204, 0.04); }
.service-card .icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 10px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 102, 204, 0.05);
    border: 1px solid rgba(0, 102, 204, 0.06);
    overflow: hidden;
    padding: 8px;
    transition: all 0.3s;
}
.service-card:hover .icon { border-color: rgba(0, 102, 204, 0.15); }
.service-card .icon img { width: 100%; height: 100%; object-fit: contain; border-radius: 8px; }
.service-card h3 { font-size: 13px; font-weight: 600; margin-bottom: 4px; color: #fff; }
.service-card .sub { font-size: 11px; color: #445566; margin-bottom: 8px; }
.service-card .price { display: inline-block; padding: 4px 12px; background: rgba(0, 102, 204, 0.08); border-radius: 12px; font-size: 12px; font-weight: 600; color: #0088FF; }
.service-card .order-btn {
    margin-top: 10px;
    width: 100%;
    padding: 8px;
    font-size: 12px;
    border: none;
    border-radius: 8px;
    background: linear-gradient(135deg, #0066CC, #0088FF);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}
.service-card .order-btn:hover { transform: scale(1.02); }
.service-card .order-btn:disabled { opacity: 0.5; cursor: not-allowed; }

/* ========================================== */
/* EMPTY STATE */
/* ========================================== */
.empty-state { text-align: center; padding: 40px 20px; }
.empty-state i { font-size: 48px; color: #0f1a2e; margin-bottom: 16px; }
.empty-state h3 { font-size: 18px; margin-bottom: 8px; color: #fff; }
.empty-state p { color: #445566; font-size: 14px; margin-bottom: 20px; }

/* ========================================== */
/* BOTTOM NAV */
/* ========================================== */
.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #0a0e17;
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(0, 102, 204, 0.05);
    display: flex;
    padding: 8px 0 env(safe-area-inset-bottom);
    z-index: 1000;
}
.nav-item {
    flex: 1;
    background: none;
    border: none;
    color: #334455;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 0;
    font-size: 10px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s;
    font-family: 'Inter', sans-serif;
}
.nav-item i { font-size: 20px; }
.nav-item.active { color: #0088FF; }
.nav-item:hover { color: #8899bb; }

/* ========================================== */
/* MODAL */
/* ========================================== */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}
.modal.show { display: flex; }
.modal-content {
    background: #0f1a2e;
    border-radius: 20px;
    padding: 30px 24px;
    max-width: 420px;
    width: 95%;
    max-height: 90vh;
    overflow-y: auto;
    border: 1px solid rgba(0, 102, 204, 0.08);
    animation: modalIn 0.3s ease;
}
@keyframes modalIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.modal-header h2 { font-size: 20px; font-weight: 700; }
.modal-close { background: rgba(255, 255, 255, 0.03); border: none; color: #445566; width: 36px; height: 36px; border-radius: 50%; font-size: 20px; cursor: pointer; transition: all 0.3s; }
.modal-close:hover { background: rgba(255, 255, 255, 0.06); }
.modal-tabs { display: flex; gap: 8px; margin-bottom: 20px; }
.tab-btn {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    color: #445566;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    font-family: 'Inter', sans-serif;
}
.tab-btn.active { background: rgba(0, 102, 204, 0.12); color: #0088FF; }
.auth-form { display: block; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 13px; font-weight: 500; color: #445566; margin-bottom: 6px; }
.form-group input, .form-group select, .form-group textarea {
    width: 100%;
    padding: 12px 14px;
    background: #0a0e17;
    border: 1px solid rgba(0, 102, 204, 0.06);
    border-radius: 10px;
    color: #fff;
    font-size: 14px;
    font-family: 'Inter', sans-serif;
    transition: border-color 0.3s;
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: rgba(0, 102, 204, 0.2); }
.form-group input::placeholder, .form-group textarea::placeholder { color: #334455; }
.form-group select option { background: #0f1a2e; color: #fff; }
.form-group textarea { resize: vertical; min-height: 80px; }

/* Buttons */
.btn {
    padding: 14px 34px;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    font-size: 16px;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
}
.btn-primary { background: linear-gradient(135deg, #0066CC, #0088FF); color: #fff; box-shadow: 0 4px 20px rgba(0, 102, 204, 0.2); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 30px rgba(0, 102, 204, 0.3); }
.btn-secondary { background: rgba(0, 102, 204, 0.06); color: #fff; border: 1px solid rgba(0, 102, 204, 0.1); }
.btn-secondary:hover { background: rgba(0, 102, 204, 0.1); }
.modal-footer { margin-top: 16px; text-align: center; color: #334455; font-size: 12px; }
.modal-footer a { color: #0088FF; text-decoration: none; }

/* ========================================== */
/* DEPOSIT */
/* ========================================== */
.deposit-info { text-align: center; padding: 16px; background: rgba(0, 102, 204, 0.03); border-radius: 12px; margin-bottom: 20px; }
.deposit-info strong { color: #0088FF; font-size: 20px; }
.deposit-options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px; }
.deposit-option { background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(0, 102, 204, 0.06); border-radius: 10px; padding: 12px; text-align: center; cursor: pointer; transition: all 0.3s; font-family: 'Inter', sans-serif; }
.deposit-option:hover { border-color: rgba(0, 102, 204, 0.15); background: rgba(0, 102, 204, 0.03); }
.deposit-option .amount { display: block; font-size: 16px; font-weight: 700; color: #fff; }
.deposit-option .bonus { display: block; font-size: 11px; color: #22c55e; margin-top: 2px; }
.deposit-custom { display: flex; gap: 10px; margin-bottom: 16px; }
.deposit-custom input { flex: 1; padding: 10px 14px; background: #0a0e17; border: 1px solid rgba(0, 102, 204, 0.06); border-radius: 10px; color: #fff; font-size: 14px; font-family: 'Inter', sans-serif; }
.deposit-custom input:focus { outline: none; border-color: rgba(0, 102, 204, 0.2); }
.deposit-methods { text-align: center; padding-top: 16px; border-top: 1px solid rgba(0, 102, 204, 0.05); }
.deposit-methods p { color: #445566; font-size: 13px; margin-bottom: 10px; }
.payment-icons { display: flex; justify-content: center; gap: 16px; font-size: 28px; color: #334455; }

/* ========================================== */
/* NOTIFICATION */
/* ========================================== */
#notificationContainer {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 360px;
}
.notification {
    padding: 14px 18px;
    border-radius: 12px;
    background: #0f1a2e;
    border: 1px solid rgba(0, 102, 204, 0.08);
    color: #fff;
    font-size: 14px;
    animation: slideIn 0.3s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}
.notification button { background: none; border: none; color: #445566; font-size: 18px; cursor: pointer; }
@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

/* ========================================== */
/* EXIT POPUP */
/* ========================================== */
.exit-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 99999;
}
.exit-popup.show { display: flex; }
.exit-popup-content {
    text-align: center;
    padding: 40px;
    background: #0f1a2e;
    border-radius: 20px;
    border: 1px solid rgba(0, 102, 204, 0.08);
    max-width: 380px;
    animation: modalIn 0.4s ease;
}
.exit-popup-content img { width: 80px; border-radius: 16px; margin-bottom: 16px; }
.exit-popup-content h3 { font-size: 20px; margin-bottom: 8px; }
.exit-popup-content p { color: #445566; margin-bottom: 20px; }
.exit-popup-content button { padding: 10px 36px; border: none; border-radius: 10px; background: linear-gradient(135deg, #0066CC, #0088FF); color: #fff; font-weight: 600; cursor: pointer; transition: all 0.3s; }
.exit-popup-content button:hover { transform: scale(1.05); }

/* ========================================== */
/* RESPONSIVE */
/* ========================================== */
@media (max-width: 768px) {
    .hero-content { flex-direction: column; text-align: center; }
    .hero-text h1 { font-size: 32px; }
    .hero-buttons { justify-content: center; }
    .hero-image img { max-height: 200px; }
    .slider-btn.prev { left: 0; }
    .slider-btn.next { right: 0; }
    .slider-btn { width: 36px; height: 36px; font-size: 14px; }
    .hero-stats { flex-wrap: wrap; gap: 20px; padding: 20px; }
    .stat-number { font-size: 28px; }
    .services-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .service-card { padding: 12px; }
    .service-card .icon { width: 40px; height: 40px; }
    .header-balance { padding: 10px 12px; }
    .balance-amount { font-size: 16px; }
    .deposit-options { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 600px) {
    .services-grid { grid-template-columns: repeat(3, 1fr); }
}
